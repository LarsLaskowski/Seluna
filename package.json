{
  "name": "seluna",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "coverage:lcov": "vitest run --coverage --coverage.reporter=lcov",
    "types": "wrangler types",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run db:migrations:apply && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.1"
  },
  "cloudflare": {
    "bindings": {
      "SELUNA_SECRET": {
        "description": "A random string of at least 32 characters, for example from a password manager or `openssl rand -hex 32`. It is the password of the `/setup` page and protects the stored credentials. Keep it: changing it later means running the setup again."
      }
    }
  }
}
