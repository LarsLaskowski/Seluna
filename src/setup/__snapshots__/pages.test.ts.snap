exports[`the pages before this change > the body text of the 'github created without a slug' page in 'de' is unchanged 1`] = `"Sprache: English | Deutsch GitHub-App Die GitHub-App ist gespeichert. Installiere sie auf GitHub: Öffne in den Einstellungen deines Kontos oder deiner Organisation Developer settings, dann GitHub Apps, wähle die App und klicke auf Install App. Empfohlen ist die Auswahl All repositories, damit auch neue Repositories erfasst werden."`;

exports[`the pages before this change > the body text of the 'github created without a slug' page in 'en' is unchanged 1`] = `"Language: English | Deutsch GitHub App The GitHub App is saved. Install it on GitHub: in the settings of your account or organization, open Developer settings, then GitHub Apps, choose the app and select Install App. Choosing All repositories is recommended, so that new repositories are covered too."`;

exports[`the pages before this change > the body text of the 'github created' page in 'de' is unchanged 1`] = `"Sprache: English | Deutsch GitHub-App Die GitHub-App ist gespeichert. Installiere sie jetzt auf deinem Konto oder deiner Organisation. Empfohlen ist die Auswahl All repositories, damit auch neue Repositories erfasst werden. App auf GitHub installieren"`;

exports[`the pages before this change > the body text of the 'github created' page in 'en' is unchanged 1`] = `"Language: English | Deutsch GitHub App The GitHub App is saved. Now install it on your account or organization. Choosing All repositories is recommended, so that new repositories are covered too. Install the app on GitHub"`;

exports[`the pages before this change > the body text of the 'github finish with a notice' page in 'de' is unchanged 1`] = `"Sprache: English | Deutsch GitHub-App GitHub hat die App erstellt. Wähle Abschließen, damit Seluna ihre Zugangsdaten abruft und speichert. GitHub war nicht erreichbar. Wähle gleich noch einmal Abschließen; die Rückkehr bleibt eine Stunde lang gültig. Abschließen"`;

exports[`the pages before this change > the body text of the 'github finish with a notice' page in 'en' is unchanged 1`] = `"Language: English | Deutsch GitHub App GitHub has created the app. Select Finish so that Seluna fetches and saves its credentials. GitHub could not be reached. Select Finish again in a moment; the return stays valid for one hour. Finish"`;

exports[`the pages before this change > the body text of the 'github finish' page in 'de' is unchanged 1`] = `"Sprache: English | Deutsch GitHub-App GitHub hat die App erstellt. Wähle Abschließen, damit Seluna ihre Zugangsdaten abruft und speichert. Abschließen"`;

exports[`the pages before this change > the body text of the 'github finish' page in 'en' is unchanged 1`] = `"Language: English | Deutsch GitHub App GitHub has created the app. Select Finish so that Seluna fetches and saves its credentials. Finish"`;

exports[`the pages before this change > the body text of the 'github form with a notice' page in 'de' is unchanged 1`] = `"Sprache: English | Deutsch GitHub-App Seluna empfängt die Ereignisse deiner Repositories über eine eigene, private GitHub-App. Erstelle sie hier für dein persönliches Konto oder für eine Organisation: Seluna sendet GitHub ein Manifest mit dem Namen der App, der Webhook-Adresse dieser Instanz und reinen Leserechten und speichert die Zugangsdaten der App verschlüsselt, sobald du auf GitHub bestätigt hast. Wähle dein persönliches Konto oder eine Organisation und gib den Namen ein: 1 bis 39 Buchstaben, Ziffern und Bindestriche, ohne Bindestrich am Anfang oder Ende. Es ist noch keine GitHub-App gespeichert. Mein persönliches Konto Eine Organisation Name des Kontos oder der Organisation, wie in github.com/name Weiter"`;

exports[`the pages before this change > the body text of the 'github form with a notice' page in 'en' is unchanged 1`] = `"Language: English | Deutsch GitHub App Seluna receives the events of your repositories through a private GitHub App of its own. Create it here for your personal account or for an organization: Seluna sends GitHub a manifest with the app&#39;s name, the webhook address of this instance and read-only permissions, and saves the app&#39;s credentials encrypted once you have confirmed on GitHub. Choose your personal account or an organization and enter its name: 1 to 39 letters, digits and hyphens, not starting or ending with a hyphen. No GitHub App is saved yet. My personal account An organization Name of the account or organization, as in github.com/name Next"`;

exports[`the pages before this change > the body text of the 'github form with a saved app' page in 'de' is unchanged 1`] = `"Sprache: English | Deutsch GitHub-App Seluna empfängt die Ereignisse deiner Repositories über eine eigene, private GitHub-App. Erstelle sie hier für dein persönliches Konto oder für eine Organisation: Seluna sendet GitHub ein Manifest mit dem Namen der App, der Webhook-Adresse dieser Instanz und reinen Leserechten und speichert die Zugangsdaten der App verschlüsselt, sobald du auf GitHub bestätigt hast. Gespeicherte GitHub-App, App-ID: 12345 Eine neue App ersetzt die gespeicherte. Lösche die alte App danach auf GitHub: in den Einstellungen deines Kontos oder deiner Organisation unter Developer settings, dann GitHub Apps. Mein persönliches Konto Eine Organisation Name des Kontos oder der Organisation, wie in github.com/name Weiter"`;

exports[`the pages before this change > the body text of the 'github form with a saved app' page in 'en' is unchanged 1`] = `"Language: English | Deutsch GitHub App Seluna receives the events of your repositories through a private GitHub App of its own. Create it here for your personal account or for an organization: Seluna sends GitHub a manifest with the app&#39;s name, the webhook address of this instance and read-only permissions, and saves the app&#39;s credentials encrypted once you have confirmed on GitHub. Saved GitHub App, App ID: 12345 Creating a new app replaces the saved one. Delete the old app on GitHub afterwards: in the settings of your account or organization, under Developer settings, then GitHub Apps. My personal account An organization Name of the account or organization, as in github.com/name Next"`;

exports[`the pages before this change > the body text of the 'github form' page in 'de' is unchanged 1`] = `"Sprache: English | Deutsch GitHub-App Seluna empfängt die Ereignisse deiner Repositories über eine eigene, private GitHub-App. Erstelle sie hier für dein persönliches Konto oder für eine Organisation: Seluna sendet GitHub ein Manifest mit dem Namen der App, der Webhook-Adresse dieser Instanz und reinen Leserechten und speichert die Zugangsdaten der App verschlüsselt, sobald du auf GitHub bestätigt hast. Es ist noch keine GitHub-App gespeichert. Mein persönliches Konto Eine Organisation Name des Kontos oder der Organisation, wie in github.com/name Weiter"`;

exports[`the pages before this change > the body text of the 'github form' page in 'en' is unchanged 1`] = `"Language: English | Deutsch GitHub App Seluna receives the events of your repositories through a private GitHub App of its own. Create it here for your personal account or for an organization: Seluna sends GitHub a manifest with the app&#39;s name, the webhook address of this instance and read-only permissions, and saves the app&#39;s credentials encrypted once you have confirmed on GitHub. No GitHub App is saved yet. My personal account An organization Name of the account or organization, as in github.com/name Next"`;

exports[`the pages before this change > the body text of the 'github notice-only' page in 'de' is unchanged 1`] = `"Sprache: English | Deutsch GitHub-App Diese Rückkehr von GitHub gehört nicht zu deiner aktuellen Anmeldung oder ist älter als eine Stunde, daher wurde nichts gespeichert. Falls GitHub eine App erstellt hat, lösche sie auf GitHub und beginne erneut. Zurück zum Schritt GitHub-App"`;

exports[`the pages before this change > the body text of the 'github notice-only' page in 'en' is unchanged 1`] = `"Language: English | Deutsch GitHub App This return from GitHub does not belong to your current sign-in or is older than one hour, so nothing was saved. If GitHub created an app, delete it on GitHub and start again. Back to the GitHub App step"`;

exports[`the pages before this change > the body text of the 'github partial-worker-secrets' page in 'de' is unchanged 1`] = `"Sprache: English | Deutsch GitHub-App Einige, aber nicht alle der Worker-Secrets GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY und GITHUB_WEBHOOK_SECRET sind gesetzt. Setze alle drei, um die App von Hand zu konfigurieren, oder lösche sie, um die App hier zu erstellen."`;

exports[`the pages before this change > the body text of the 'github partial-worker-secrets' page in 'en' is unchanged 1`] = `"Language: English | Deutsch GitHub App Some, but not all, of the Worker secrets GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY and GITHUB_WEBHOOK_SECRET are set. Set all three to configure the app by hand, or delete them to create the app here."`;

exports[`the pages before this change > the body text of the 'github reset-needed' page in 'de' is unchanged 1`] = `"Sprache: English | Deutsch GitHub-App Die gespeicherten GitHub-Zugangsdaten lassen sich mit dem aktuellen SELUNA_SECRET nicht lesen: Es wurde geändert, oder die gespeicherten Werte sind beschädigt. Setze das frühere SELUNA_SECRET wieder, oder setze die gespeicherten Zugangsdaten auf der Startseite zurück und erstelle die App danach erneut. Startseite öffnen"`;

exports[`the pages before this change > the body text of the 'github reset-needed' page in 'en' is unchanged 1`] = `"Language: English | Deutsch GitHub App The saved GitHub credentials cannot be read with the current SELUNA_SECRET: it was changed, or the saved values are damaged. Set the earlier SELUNA_SECRET again, or reset the saved credentials on the start page and create the app again. Open the start page"`;

exports[`the pages before this change > the body text of the 'github review of a personal account' page in 'de' is unchanged 1`] = `"Sprache: English | Deutsch GitHub-App Seluna bittet GitHub, diese App zu erstellen. Prüfe auf GitHub die Angaben und wähle Create GitHub App; GitHub schickt dich danach hierher zurück. Seluna speichert die App nur, wenn GitHub sie für das hier gezeigte Konto erstellt hat. Konto: octocat (Mein persönliches Konto) App-Name: seluna-demo Berechtigungen, alle nur lesend: Actions, Pull requests, Dependabot alerts, Code scanning alerts, Secret scanning alerts, Metadata Ereignisse: Pull request, Workflow run, Dependabot alert, Code scanning alert, Secret scanning alert Weiter zu GitHub"`;

exports[`the pages before this change > the body text of the 'github review of a personal account' page in 'en' is unchanged 1`] = `"Language: English | Deutsch GitHub App Seluna asks GitHub to create this app. On GitHub, check the details and select Create GitHub App; GitHub then sends you back here. Seluna saves the app only if GitHub created it for the account shown here. Account: octocat (My personal account) App name: seluna-demo Permissions, all read-only: Actions, Pull requests, Dependabot alerts, Code scanning alerts, Secret scanning alerts, Metadata Events: Pull request, Workflow run, Dependabot alert, Code scanning alert, Secret scanning alert Continue to GitHub"`;

exports[`the pages before this change > the body text of the 'github review of an organization' page in 'de' is unchanged 1`] = `"Sprache: English | Deutsch GitHub-App Seluna bittet GitHub, diese App zu erstellen. Prüfe auf GitHub die Angaben und wähle Create GitHub App; GitHub schickt dich danach hierher zurück. Seluna speichert die App nur, wenn GitHub sie für das hier gezeigte Konto erstellt hat. Konto: octo-org (Eine Organisation) App-Name: seluna-demo Berechtigungen, alle nur lesend: Actions, Pull requests, Dependabot alerts, Code scanning alerts, Secret scanning alerts, Metadata Ereignisse: Pull request, Workflow run, Dependabot alert, Code scanning alert, Secret scanning alert Weiter zu GitHub"`;

exports[`the pages before this change > the body text of the 'github review of an organization' page in 'en' is unchanged 1`] = `"Language: English | Deutsch GitHub App Seluna asks GitHub to create this app. On GitHub, check the details and select Create GitHub App; GitHub then sends you back here. Seluna saves the app only if GitHub created it for the account shown here. Account: octo-org (An organization) App name: seluna-demo Permissions, all read-only: Actions, Pull requests, Dependabot alerts, Code scanning alerts, Secret scanning alerts, Metadata Events: Pull request, Workflow run, Dependabot alert, Code scanning alert, Secret scanning alert Continue to GitHub"`;

exports[`the pages before this change > the body text of the 'github worker-secrets' page in 'de' is unchanged 1`] = `"Sprache: English | Deutsch GitHub-App Die GitHub-App wird durch die Worker-Secrets GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY und GITHUB_WEBHOOK_SECRET festgelegt, die Vorrang vor einer hier erstellten App haben. Um die App hier zu erstellen, lösche diese Secrets."`;

exports[`the pages before this change > the body text of the 'github worker-secrets' page in 'en' is unchanged 1`] = `"Language: English | Deutsch GitHub App The GitHub App is set by the Worker secrets GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY and GITHUB_WEBHOOK_SECRET, which take precedence over an app created here. To create the app here, delete those secrets."`;

