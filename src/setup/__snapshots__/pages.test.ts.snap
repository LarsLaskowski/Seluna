exports[`the pages before this change > the body text of the 'login with a notice' page in 'en' is unchanged 1`] = `"Language: English | Deutsch Sign in Enter the SELUNA_SECRET of this instance to open the setup. That is not the SELUNA_SECRET of this instance. SELUNA_SECRET Sign in"`;

